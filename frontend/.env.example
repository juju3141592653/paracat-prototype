# Copy to frontend/.env.local and restart `npm run dev` after editing.

# Which deployment the app opens by default: 31337 = local Anvil, 11155111 = Sepolia
VITE_CHAIN_ID=11155111
# Your browser-accessible RPC endpoint for that chain (e.g. Alchemy Sepolia). Visible to users of the app.
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Optional: Privy app ID for Privy wallet login, as in Lab 2. Leave empty to connect MetaMask directly.
VITE_PRIVY_APP_ID=
