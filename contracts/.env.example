# Copy to contracts/.env (Foundry loads it automatically). Never put a private key here:
# import it with `cast wallet import paracat-deployer --interactive` instead.

# Your Sepolia RPC endpoint, e.g. from Alchemy (as in Lab 2)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Free key from etherscan.io, used by --verify to publish the source code
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Optional demo settings (defaults shown)
# DISPUTE_WINDOW_SECONDS=60        # 72 hours (259200) in production
# FUND_SETTLEMENT_SECONDS=90       # T+1 in production
# YIELD_TIME_ACCELERATION=1440     # 1 = real time; 1440 = one minute of yield per day
# ORACLE_QUORUM=1                  # testnet default 1; set 2 and FEED_B for two independent feeds
# FEED_B=0xSecondWalletAddress     # a second wallet acting as the satellite rainfall feed
# GUARDIAN=0xGuardianWalletAddress # defaults to your deployer wallet
# SEED_INVESTORS=true              # pre-subscribe 12m from two seed investors
# SEED_GAS_WEI=4000000000000000    # test ETH sent to each seed investor for gas
# SEED_ACTIVE=false                # true = also fill and close the book and pay a premium (rehearsal state)
